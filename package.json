{
  "name": "mindreader-anna", "version": "1.0.0", "private": true, "type": "module",
  "description": "Think of something. Can Anna AI guess it in 20 questions?",
  "scripts": {
    "build": "node scripts/build.mjs", "test": "node --test tests/*.test.js",
    "validate": "anna-app validate --strict",
    "check": "node scripts/check-identity.mjs && npm run build && npm test && npm run validate",
    "dev": "anna-app dev --port 5230 --slug mindreader-game --llm-app-slug mindreader-game --llm-account https://anna.partners",
    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {"@fontsource-variable/geist": "^5.3.0", "@phosphor-icons/core": "^2.1.1"},
  "devDependencies": {"esbuild": "^0.25.12", "sharp": "^0.35.5"}
}
